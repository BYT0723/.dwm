#!/usr/bin/env bash

# $1 = <type>-<style>，如 1-2 → launchers/type-1/style-2.rasi
# 缺失/非法/样式文件不存在时静默回退默认 type-2/style-1
dir="$HOME/.dwm/rofi/launchers/type-1"
theme='style-1'
if [[ "$1" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    cand_dir="$HOME/.dwm/rofi/launchers/type-${BASH_REMATCH[1]}"
    cand_theme="style-${BASH_REMATCH[2]}"
    if [[ -f "$cand_dir/${cand_theme}.rasi" ]]; then
        dir="$cand_dir"
        theme="$cand_theme"
    fi
fi
quicklinks="$HOME/.dwm/rofi/scripts/quicklinks-mode.sh"

## Run
rofi \
    -modes "combi,quicklinks:${quicklinks},calc,emoji" \
    -combi-modes "drun,run,ssh" \
    -show-icons \
    -display-combi " " \
    -display-drun "" \
    -drun-display-format "{name} [<span weight='light' size='small'><i>({generic})</i></span>]" \
    -display-run "" \
    -display-ssh "" \
    -display-emoji "󰞅 " \
    -theme-str 'configuration {display-quicklinks: "󰖟 ";}' \
    -display-calc "󰪚 " \
    -theme-str 'configuration { calc {
        no-bold: false;
        terse: false;
        no-history: true;
        calc-command: "echo -n '{result}' | xclip -selection clipboard";
        hint-result: "Result: ";
		hint-welcome: "calculate something...";
    }}' \
    -theme-str '* {font: "JetBrainsMono Nerd Font 12"; }' \
    -theme-str 'element-text {font: "Noto Sans CJK SC 14"; }' \
    -theme-str 'configuration {terminal: "'${TERMINAL:-kitty}'";}' \
    -show combi \
    -theme "${dir}/${theme}.rasi"
